    <div>
     <head xml:id="secG.2">G.2 Reference types</head>

     <list>
      <item><hi rend="bold">event</hi>: a sequence of related actions at a particular time and
       place</item>
      <item><hi rend="bold">lemma</hi>: headword form of a word</item>
      <item><hi rend="bold">ms</hi>: manuscript, charter or other unique text-bearing object </item>
      <item><hi rend="bold">person</hi>: a human being generally believed to live or have
       lived</item>
      <item><hi rend="bold">place</hi>: a named location such as a settlement or geographical
      feature</item>
      <item><hi rend="bold">thing</hi>: a reference to something not belonging to the other
      categories, such as a mythological being or object, or a fictional person </item>
      <item><hi rend="bold">work</hi>: a textual work such as a saga, poem or learned text</item>
     </list>
    </div>
       
