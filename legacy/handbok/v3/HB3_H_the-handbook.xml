                     <cell><hi rend="code">&lt;span class="blue"&gt;</hi></cell>
                     <cell/>
                     <cell/>
                  </row>
                  <row>
                     <cell><val>initial</val></cell>
                     <cell><hi rend="code">&lt;span class="initial"&gt;</hi></cell>
                     <cell/>
                     <cell/>
                  </row>

