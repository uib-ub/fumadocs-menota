                     <cell><hi rend="code">&lt;span
                        class="entity"&gt;&lt;code&gt;&amp;amp;oogon;&lt;/code&gt;&lt;/span&gt;</hi></cell>
                     <cell>A Unicode entity: <hi rend="entity">&amp;oogon;</hi></cell>
                     <cell/>
                  </row>
                  <row>
                     <cell><val>glyph</val></cell>
                     <cell><hi rend="code">&lt;span class="glyph"&gt;</hi></cell>
