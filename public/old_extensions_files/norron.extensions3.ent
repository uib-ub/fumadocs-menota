<!-- TEI.extensions.ent file for the TEI, where the TEI is to be generated  -->
<!-- by the TEI Pizza Chef at http://www.tei-c.org/pizza.html				-->
<!-- The TEI Pizza Chef settings:											-->
<!-- Generated by selecting: - Mixed base tagset: Prose and Verse
- Toppings: linking, figures, analysis, transcr, textcrit, names/dates
- No entity set chosen since we are going to XML
- Modification files selected: norron.extensions.ent and norron.extensions.dtd
- Result b) (XML, with no tag omissibility information) selected
- Generate full DTD pressed 												-->
<!-- Made for the research group: 											-->
<!-- Editing medieval manuscripts 											-->
<!-- Centre for Advanced Study												-->
<!-- Norway, 2000-2001. 													-->
<!--																		-->
<!-- May 21, 2001 Tone Merete Bruvik										-->
<!-- Removes elements that will be modified in the TEI.extensions.dtd file	--> 
<!-- Has to be in SGML syntax												-->
<!-- ---------------------------------------------------------------------  -->

<!-- w is to be modified -->
<!ENTITY % w 'IGNORE'>

<!-- tagUsage is to be modified -->
<!ENTITY % tagUsage 'IGNORE'>

<!-- keywords is to be modified -->
<!ENTITY % keywords 'IGNORE'>

<!-- supplied is to be modified -->
<!ENTITY % supplied 'IGNORE'>

<!-- orig is to be modified -->
<!ENTITY % orig 'IGNORE'>

<!-- reg is to be modified -->
<!ENTITY % reg 'IGNORE'>

<!-- The following elements are generated invalid XML by the the Pizza Chef: -->
<!-- Pizza-chef generated errors (uneccesary inclusions) in lem and reading -->
<!-- Pizza-chef generated error (#PCDATA last in model group) in orgName -->
<!-- Errors corrected on September 25, 2000, Espen S. Ore -->
<!ENTITY % orgName 'IGNORE'>
<!ENTITY % rdg 'IGNORE'>
<!ENTITY % lem 'IGNORE'>

