<!-- change orig and reg after all.											-->
<!-- March 13, 2002 TMB: Some errors in the Pizza Chef generator are now    -->
<!-- been removed, so that the elements orgName, rdg and lem do not have 	-->
<!-- to be redefined here. The entity table is updated  so that entities 	-->
<!-- which already are available in UNICODE are using these values, 		-->
<!-- entities which is not, have all been set to the value FFFD.			-->
<!-- May 21, 2001 Tone Merete Bruvik										-->
<!-- Removes elements that will be modified in the TEI.extensions.dtd file	--> 
<!-- Has to be in SGML syntax												-->

<!-- Changes done by Tone Merete Bruvik are marked with TMB					-->
<!-- ---------------------------------------------------------------------  -->

<!-- note added to the content model of orig May 21, 2001, TMB -->

<!-- orig is to be modified -->
<!ENTITY % orig 'IGNORE'>

<!-- reg is to be modified -->
<!ENTITY % reg 'IGNORE'>

<!-- w is to be modified -->
<!ENTITY % w 'IGNORE'>

<!-- tagUsage is to be modified -->
<!ENTITY % tagUsage 'IGNORE'>

<!-- keywords is to be modified -->
<!ENTITY % keywords 'IGNORE'>

<!-- supplied is to be modified -->
<!ENTITY % supplied 'IGNORE'>

