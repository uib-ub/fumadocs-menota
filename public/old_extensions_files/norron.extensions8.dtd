<!ELEMENT physDesc %om.RR; (p+ | (form?, support?, extent?, collation?, layout?, msWriting?, musicNotation?, decoration?, bindingDesc?, foliation*, additions?, condition?))>
<!ATTLIST physDesc %a.global; >
 <!-- extent is defined elsewhere -->
