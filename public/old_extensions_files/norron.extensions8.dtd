<!-- 2/5-2002 TMB: Changed from expform to expForm -->
<!-- Element expform added to the dtd on April 24, 2001, ESO -->
<!-- note and supplied added to the content model of expform May 21, 2001, TMB -->
<!ELEMENT expForm %om.RR;
	(#PCDATA | expan | seg | w | m | c | alt | altGrp | index | interp 
	| interpGrp | join | joinGrp | link | linkGrp | span | spanGrp 
	| timeline | cb | lb | milestone | pb | addSpan | delSpan 
	| gap | anchor | hi | unclear | add | del | note | supplied | %m.fragmentary;)* >

<!ATTLIST expForm 
	%a.global;	
	function CDATA #IMPLIED
	part (Y | N | I | M | F) "N"
	type CDATA #IMPLIED
	lemma CDATA #IMPLIED>
	
	

<!-- *********************************************************************  -->
<!-- ELEMENTS WHICH ARE CHANGED IN THIS EXTENSION TO TEI		 			-->
<!-- *********************************************************************  -->
 
<!-- note added to the content model of orig and reg. TMB: 22/3-2002:  -->
<!ELEMENT orig %om.RR;  (%phrase; | note)* > 
<!ATTLIST orig  
      %a.global;
      reg CDATA #IMPLIED
      resp CDATA #IMPLIED>

<!-- note added to the content model of orig and reg. TMB: 22/3-2002:  -->
<!ELEMENT reg %om.RR;  (%phrase; | note)* > 
<!ATTLIST reg  
      %a.global;
      orig CDATA #IMPLIED
      resp CDATA #IMPLIED>

<!-- lacunaEnd, lacunaStart, witEnd and witStart added to the content model of w. TMB: 15/3-2002:  -->
<!-- orig, reg and expform added to the content model of w April 24, 2001, ESO -->
<!-- (Recursive) w-element removed from the content model April 24, 2001, ESO -->
<!-- add, del, unclear and supplied added to the content model of w June 8, 2001, OEH and KGJ -->
<!ELEMENT w %om.RR; (#PCDATA | seg | m | c | orig | reg | expForm | add 
					| del | unclear | supplied | %m.fragmentary;| %m.Incl;)*> 

<!-- pos attribute added on May 21, 2001, TMB -->
<!ATTLIST w  
      %a.global;
      %a.seg;
      lemma CDATA #IMPLIED
	  pos CDATA #IMPLIED>

<!-- lacunaEnd, lacunaStart, witEnd and witStart added to the content model of tagUsage. TMB: 15/3-2002:  -->
<!-- type-, reason-, resp- and source-attributes added on April 24, 2001, ESO -->
<!ELEMENT tagUsage %om.RO; (#PCDATA | %m.phrase; | %m.inter; | %m.Incl; | %m.fragmentary;)* > 
<!ATTLIST tagUsage 
	%a.global;
	gi NMTOKEN #REQUIRED
	occurs NMTOKEN #IMPLIED
	ident NMTOKEN #IMPLIED
	render IDREF #IMPLIED
	type CDATA #IMPLIED
	reason CDATA #IMPLIED
	resp CDATA #IMPLIED
	source CDATA #IMPLIED >


<!-- #PCDATA was added, and by that changed it into mixed context -->
<!-- Content model modified April 24, 2001, ESO -->
<!ELEMENT keywords %om.RO; (#PCDATA | term | list)* >
<!ATTLIST keywords  
      %a.global;
      scheme IDREF #IMPLIED>


<!-- lacunaEnd, lacunaStart, witEnd and witStart added to the content model of supplied. TMB: 15/3-2002:  -->
<!-- type-attribute added April 24, 2001, ESO -->
<!ELEMENT supplied %om.RO;  (#PCDATA | %m.phrase; | %m.inter; | %m.Incl; | %m.fragmentary;)* > 
<!ATTLIST supplied  
      %a.global;
      reason CDATA #IMPLIED
      resp CDATA %INHERITED;
      hand IDREF %INHERITED;
      agent CDATA #IMPLIED
      source CDATA #IMPLIED
      type CDATA #IMPLIED>


