<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
	attributeFormDefault="unqualified">
	<xs:element name="transcription">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="text" minOccurs="1" maxOccurs="unbounded">
					<xs:complexType mixed="true">
						<xs:sequence minOccurs="0" maxOccurs="unbounded">
							<xs:group ref="Breaks" minOccurs="0"/>
							<xs:element name="div" type="Div" minOccurs="0"/>
							<xs:element name="num" type="Numeral" minOccurs="0"/>
							<xs:element name="add" type="Addition" minOccurs="0"/>
							<xs:element name="del" type="Deletion" minOccurs="0"/>
							<xs:element name="supplied" type="Suppletion" minOccurs="0"/>
							<xs:element name="unclear" type="Unclear" minOccurs="0"/>
							<xs:element name="choice" type="Choice" minOccurs="0"/>
							<xs:element name="c" type="Character" minOccurs="0"/>
							<xs:element name="gap" type="Gap" minOccurs="0"/>
							<xs:element name="surplus" type="Surplus" minOccurs="0"/>
							<xs:element name="suppressed" type="Suppressed" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="Div">
		<xs:sequence>
			<xs:element name="head" type="Paragraph" minOccurs="0" maxOccurs="1"/>
			<xs:group ref="Breaks" minOccurs="0" maxOccurs="unbounded"/>
			<xs:choice>
				<xs:sequence minOccurs="1" maxOccurs="unbounded">
					<xs:element name="div" type="Div" minOccurs="1" maxOccurs="1"/>
					<xs:group ref="Breaks" minOccurs="0" maxOccurs="unbounded"/>
				</xs:sequence>
				<xs:sequence minOccurs="1" maxOccurs="unbounded">
					<xs:element name="p" type="Paragraph" minOccurs="1" maxOccurs="1"/>
					<xs:group ref="Breaks" minOccurs="0" maxOccurs="unbounded"/>
				</xs:sequence>
			</xs:choice>
		</xs:sequence>
		<xs:attribute name="type" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="text"/>
					<xs:enumeration value="chapter"/>
					<xs:enumeration value="reply"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="subtype">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="saga"/>
					<xs:enumeration value="dialogue"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="n">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="\d+"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="Paragraph" mixed="true">
		<xs:sequence minOccurs="0" maxOccurs="unbounded">
			<xs:group ref="Breaks" minOccurs="0"/>
			<xs:element name="num" type="Numeral" minOccurs="0"/>
			<xs:element name="add" type="Addition" minOccurs="0"/>
			<xs:element name="del" type="Deletion" minOccurs="0"/>
			<xs:element name="supplied" type="Suppletion" minOccurs="0"/>
			<xs:element name="unclear" type="Unclear" minOccurs="0"/>
			<xs:element name="choice" type="Choice" minOccurs="0"/>
			<xs:element name="c" type="Character" minOccurs="0"/>
			<xs:element name="gap" type="Gap" minOccurs="0"/>
			<xs:element name="surplus" type="Surplus" minOccurs="0"/>
			<xs:element name="suppressed" type="Suppressed" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:group name="Breaks">
		<xs:sequence>
			<xs:element name="pb" type="PageBreak" minOccurs="0" maxOccurs="1"/>
			<xs:element name="cb" type="ColBreak" minOccurs="0" maxOccurs="1"/>
			<xs:element name="lb" type="LineBreak" minOccurs="1" maxOccurs="1"/>
		</xs:sequence>
	</xs:group>
	<xs:complexType name="PageBreak">
		<xs:attribute name="n">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="\d+[prv]"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="ColBreak">
		<xs:attribute name="n">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="[ab]"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="LineBreak">
		<xs:attribute name="n">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="\d+"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="rend">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="\d"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="Numeral" mixed="true">
		<xs:attribute name="type">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="cardinal"/>
					<xs:enumeration value="ordinal"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="value" type="xs:int"/>
	</xs:complexType>
	<xs:complexType name="Addition" mixed="true">
		<xs:sequence minOccurs="0">
			<xs:element name="unclear" type="Unclear"/>
		</xs:sequence>
		<xs:attribute name="place">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="supralinear"/>
					<xs:enumeration value="margin"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="Deletion" mixed="true">
		<xs:sequence minOccurs="0">
			<xs:element name="num" type="Numeral"/>
		</xs:sequence>
		<xs:attribute name="rend">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="erasure"/>
					<xs:enumeration value="subpunction"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="type">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="expunction"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="Suppletion" mixed="true">
		<xs:sequence minOccurs="0" maxOccurs="unbounded">
			<xs:element name="c" type="Character" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="reason">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="missing"/>
					<xs:enumeration value="damage"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="Unclear" mixed="true">
		<xs:sequence maxOccurs="unbounded">
			<xs:element name="num" type="Numeral" minOccurs="0"/>
			<xs:element name="supplied" type="Suppletion" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="width" type="xs:int"/>
	</xs:complexType>
	<xs:complexType name="Choice">
		<xs:sequence minOccurs="1" maxOccurs="1">
			<xs:element name="sic" type="Sic"/>
			<xs:element name="corr" type="Corr"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Sic" mixed="true"/>
	<xs:complexType name="Corr" mixed="true"/>
	<xs:complexType name="Character" mixed="true">
		<xs:attribute name="type">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="initial"/>
					<xs:enumeration value="littNot"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="Gap"/>
	<xs:complexType name="Surplus" mixed="true"/>
	<xs:complexType name="Suppressed" mixed="true"/>
</xs:schema>