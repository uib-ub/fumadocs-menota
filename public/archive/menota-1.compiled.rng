  <rng:define name="monogr.content">
    <rng:group>
      <rng:optional>
        <rng:zeroOrMore>
          <rng:ref name="tei.Incl"/>
        </rng:zeroOrMore>
        <rng:choice>
          <rng:group>
            <rng:choice>
              <rng:ref name="author"/>
              <rng:ref name="editor"/>
              <rng:ref name="respStmt"/>
            </rng:choice>
            <rng:zeroOrMore>
              <rng:choice>
                <rng:ref name="author"/>
                <rng:ref name="editor"/>
                <rng:ref name="respStmt"/>
                <rng:ref name="tei.Incl"/>
              </rng:choice>
            </rng:zeroOrMore>
            <rng:oneOrMore>
              <rng:ref name="title"/>
              <rng:zeroOrMore>
                <rng:ref name="tei.Incl"/>
              </rng:zeroOrMore>
            </rng:oneOrMore>
            <rng:zeroOrMore>
              <rng:choice>
