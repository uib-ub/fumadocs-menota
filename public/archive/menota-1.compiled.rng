            <rng:oneOrMore>
              <rng:ref name="title"/>
              <rng:zeroOrMore>
                <rng:ref name="tei.Incl"/>
              </rng:zeroOrMore>
            </rng:oneOrMore>
            <rng:zeroOrMore>
              <rng:choice>
