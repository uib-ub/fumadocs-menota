                <rng:ref name="editor"/>
                <rng:ref name="respStmt"/>
              </rng:choice>
              <rng:zeroOrMore>
                <rng:ref name="tei.Incl"/>
              </rng:zeroOrMore>
            </rng:zeroOrMore>
          </rng:group>
        </rng:choice>
      </rng:optional>
      <rng:zeroOrMore>
        <rng:choice>
          <rng:ref name="note"/>
          <rng:ref name="meeting"/>
        </rng:choice>
        <rng:zeroOrMore>
