  [ a:defaultValue = "particLinks" ] attribute TEIform { text }?
relation =
  
  ## (relationship) describes any kind of relationship or linkage amongst a specified
  ## group of participants.
  element relation { relation.content, relation.attributes }
relation.content = empty
relation.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  
  ## categorizes the relationship in some respect, e.g.
  ## as social, personal or other.
  [ a:defaultValue = "personal" ] attribute type { text }?,
  
  ## briefly describes the relationship.
  attribute desc { text },
  
  ## identifies the activeparticipants in a non-mutual
  ## relationship, or all the participants in a mutual one.
  attribute active { datatype.uriList },
  
  ## identifies the passive participants in a non-mutual
  ## relationship.
  attribute passive { datatype.uriList },
  
  ## indicates whether the relationship holds equally amongst all the
  ## participants.
  [ a:defaultValue = "true" ] attribute mutual { xsd:boolean }?,
  [ a:defaultValue = "relation" ] attribute TEIform { text }?
setting =
  
  ## (setting) describes one particular setting in which a language interaction
  ## takes place.
  element setting { setting.content, setting.attributes }
setting.content = p+ | (name | time | date | locale | activity)*
setting.attributes =
  tei.global.attribute.xmlid,
