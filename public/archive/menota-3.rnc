  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  tei.temporalExpr.attribute.value,
  tei.temporalExpr.attribute.key,
  tei.temporalExpr.attribute.reg,
  tei.temporalExpr.attribute.type,
  tei.temporalExpr.attribute.full,
  [ a:defaultValue = "year" ] attribute TEIform { text }?
occasion =
  
  ## () a temporal expression (either a date or a time)
  ## given in terms of a named occasion such as a holiday,
  ## a named time of day, or some notable event.
  element occasion { occasion.content, occasion.attributes }
occasion.content = macro.phraseSeq
occasion.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  tei.temporalExpr.attribute.value,
  tei.temporalExpr.attribute.key,
  tei.temporalExpr.attribute.reg,
  tei.temporalExpr.attribute.type,
  tei.temporalExpr.attribute.full,
  [ a:defaultValue = "occasion" ] attribute TEIform { text }?
timeStruct =
  
  ## () contains an internally structured representation for a time of day.
  element timeStruct { timeStruct.content, timeStruct.attributes }
timeStruct.content = (text | tei.temporalExpr | tei.Incl)*
timeStruct.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  tei.temporalExpr.attribute.value,
  tei.temporalExpr.attribute.key,
  tei.temporalExpr.attribute.reg,
  tei.temporalExpr.attribute.type,
  tei.temporalExpr.attribute.full,
  
  ## indicates time zone or place name wherever this is necessary to
  ##		evaluate a temporal expression.
  attribute zone { text }?,
  [ a:defaultValue = "timeStruct" ] attribute TEIform { text }?
second =
  
  ## (second) the second component of a structured time-expression.
  element second { second.content, second.attributes }
second.content = text
second.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  tei.temporalExpr.attribute.value,
  tei.temporalExpr.attribute.key,
  tei.temporalExpr.attribute.reg,
  tei.temporalExpr.attribute.type,
  tei.temporalExpr.attribute.full,
  [ a:defaultValue = "second" ] attribute TEIform { text }?
minute =
  
  ## (minute) the minute component of a structured time-expression.
  element minute { minute.content, minute.attributes }
minute.content = text
minute.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
