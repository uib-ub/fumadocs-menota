  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  [ a:defaultValue = "recordHist" ] attribute TEIform { text }?
source =
  
  ## () describes the original source for the information contained with a manuscript description. 
  element source { source.content, source.attributes }
source.content = tei.paragraph+
source.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
