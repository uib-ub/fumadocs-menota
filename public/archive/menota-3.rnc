  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  [ a:defaultValue = "castGroup" ] attribute TEIform { text }?
castItem =
  
  ## (Cast list item) contains a single entry within a cast list, describing
  ## either a single role or a list of non-speaking roles.
  element castItem { castItem.content, castItem.attributes }
castItem.content =
  (text | role | roleDesc | actor | tei.phrase | tei.Incl)*
castItem.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  
  ## characterizes the cast item.
  [ a:defaultValue = "role" ]
  attribute type {
    
    ## (the item describes a single role.) 
    "role"
    | 
      ## (the item describes a list of non-speaking roles.) 
      "list"
  }?,
  [ a:defaultValue = "castItem" ] attribute TEIform { text }?
role =
  
  ## () the name of a dramatic role, as given in a cast list.
