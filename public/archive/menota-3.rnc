  tei.datable.attribute.certainty,
  tei.datable.attribute.dateAttrib,
  tei.datable.attribute.evidence,
  [ a:defaultValue = "provenance" ] attribute TEIform { text }?
acquisition =
  
  ## () contains any descriptive or other information
