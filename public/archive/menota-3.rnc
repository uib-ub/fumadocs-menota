  ## indicates the kind of information held in the cell.
  [ a:defaultValue = "data" ] attribute role { text }?,
  
  ## indicates the number of rows occupied by this cell.
  [ a:defaultValue = "1" ] attribute rows { xsd:nonNegativeInteger }?,
  
  ## indicates the number of columns occupied by this cell.
  [ a:defaultValue = "1" ] attribute cols { xsd:nonNegativeInteger }?,
  [ a:defaultValue = "cell" ] attribute TEIform { text }?
formula =
  
  ## () contains a mathematical or other formula.
  element formula { formula.content, formula.attributes }
formula.content = datatype.Formula
formula.attributes =
