  ##       element lie.
  attribute domains {
    list { xsd:anyURI, xsd:anyURI+ }
  }?
tei.pointerGroup.attribute.targFunc =
  
  ## describes the function of each of the values of the
  ##       targets attribute of the enclosed link,
  ##       join or alt tags.
  attribute targFunc {
    list { xsd:NCName, xsd:NCName+ }
  }?
