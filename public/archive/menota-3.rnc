  tei.analysis.attribute.ana,
  tei.names.attribute.role,
  tei.names.attribute.key,
  tei.names.attribute.reg,
  [ a:defaultValue = "collection" ] attribute TEIform { text }?
altIdentifier =
  
  ## (alternative identifier) contains an alternative or former structured identifier used for
  ## a manuscript, such as a former catalogue number.
  element altIdentifier {
    altIdentifier.content, altIdentifier.attributes
  }
altIdentifier.content =
  country?,
  region?,
  settlement?,
  institution?,
  repository?,
  collection?,
  idno
altIdentifier.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
