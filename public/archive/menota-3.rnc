  tei.analysis.attribute.ana,
  
  ## () further characterizes the accompanying material, for example as letter, note, paste-in, etc.
  attribute type { datatype.Key }?,
  [ a:defaultValue = "accMat" ] attribute TEIform { text }?
history =
  
  ## ()  groups elements
  ## describing the full history of a manuscript or manuscript part.
  element history { history.content, history.attributes }
history.content = tei.paragraph+ | (origin?, provenance*, acquisition?)
history.attributes =
