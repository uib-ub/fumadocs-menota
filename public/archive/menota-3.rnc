  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  [ a:defaultValue = "headLabel" ] attribute TEIform { text }?
headItem =
  
  ## (heading for list items) contains the heading for the item or gloss column in a
  ## glossary list or similar structured list.
  element headItem { headItem.content, headItem.attributes }
headItem.content = macro.phraseSeq
headItem.attributes =
  tei.global.attribute.xmlid,
