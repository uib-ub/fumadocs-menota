  tei.metrical.attribute.ass,
  tei.metrical.attribute.all,
  tei.metrical.attribute.met,
  tei.metrical.attribute.real,
  tei.metrical.attribute.rhyme,
  [ a:defaultValue = "lg4" ] attribute TEIform { text }?
lg5 =
  
  ## (line group) contains a fifth-level (i.e. smallest) group of verse lines
  ## functioning as a formal unit e.g. a stanza, refrain, verse paragraph,
  ## etc.
  element lg5 { lg5.content, lg5.attributes }
lg5.content = tei.Incl*, (head, tei.Incl*)?, (l, tei.Incl*)+
lg5.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  tei.divn.attribute.type,
  tei.divn.attribute.org,
  tei.divn.attribute.sample,
  tei.divn.attribute.part,
  tei.metrical.attribute.ass,
  tei.metrical.attribute.all,
  tei.metrical.attribute.met,
  tei.metrical.attribute.real,
  tei.metrical.attribute.rhyme,
  [ a:defaultValue = "lg5" ] attribute TEIform { text }?
caesura =
  
  ## () marks the point at which a metrical line may be divided.
  element caesura { caesura.content, caesura.attributes }
caesura.content = empty
caesura.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  [ a:defaultValue = "caesura" ] attribute TEIform { text }?
dipl =
  
  ## 2004.04.28 TMB: Using 'a.seg' to include
  ##                         the attributes 'type', 'function' and 'part',
  ##                         thus the attributes in a.metrical will also be
  ##                         included, although these are probably not used
  ##                         in Menota texts.2004.04.15 TMB: added
  ##                         comments: the element is based on the element
  ##                         'orig' in TEI, but with some changes: 'note'
  ##                         and 'm.fragmentary' are added to the content
  ##                         model, and 'function', 'part' and 'type' are
  ##                         added as attributes. The attributes 'reg' and
  ##                         'resp' correspond to the same attributes in the
  ##                         orig-element i TEI: 'reg' (regularization):
  ##                         gives a regularized (normalized) form of the
  ##                         text. 'resp' (responsibility): identifies the
  ##                         individual responsible for the regularization
  ##                         of the word or phrase. The attributes
  ##                         'function', 'part' and 'type' are like the same
  ##                         attributes in the a.seg i TEI: 'type':
  ##                         characterizes the type of segment. 'function':
  ##                         characterizes the function of the segment.
  ##                         'part': specifies whether or not the segment is
  ##                         fragmented by some other structural element,
  ##                         for example a clause which is divided between
  ##                             two or more sentences.2003.05.14 OEH: changed
  ##                         name of element 'expForm' to 'dipl'. Also
  ##                         changed the content model for this element as
  ##                         parameter entity 'phrase' is used instead of
  ##                         previous content model to ensure conformity
  ##                         between the 'facs', 'dipl' and 'norm' elements.
  ##                         2002.05.02 TMB: changed from expform to
  ##                             expForm. 2001.05.21 TMB: note and supplied
  ##                         added to the content model of expform.
  ##                         2001.04.24 ESO: element expform added to the
  ##                         dtd.
  element dipl { dipl.content, dipl.attributes }
dipl.content = (text | tei.phrase | note | tei.fragmentary | tei.Incl)*
dipl.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  tei.seg.attribute.type,
  tei.seg.attribute.function,
  tei.seg.attribute.part,
  tei.metrical.attribute.ass,
  tei.metrical.attribute.all,
  tei.metrical.attribute.met,
  tei.metrical.attribute.real,
  tei.metrical.attribute.rhyme,
  
  ##
  attribute resp { text }?,
  
  ##
  attribute reg { text }?,
  [ a:defaultValue = "dipl" ] attribute TEIform { text }?
expunged =
  
  ## 2005.06.07 tmb: Changed to content model
  ##                         to be as 'facs', in order to include encoding
  ##                         as well as textNew ELEMENT expunged. Made with the
  ##                         element 'del' as model, contains a letter, word
  ##                         or passage expunged, marked as expunged, or
  ##                         otherwise indicated as superfluous or spurious
  ##                         in the copy text by the transcriber or editor.
  ##                         Added by TMB, 2004.06.24
  element expunged { expunged.content, expunged.attributes }
expunged.content =
  (text | tei.phrase | note | tei.fragmentary | tei.Incl)*
expunged.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  tei.seg.attribute.function,
  tei.seg.attribute.part,
  tei.metrical.attribute.ass,
  tei.metrical.attribute.all,
  tei.metrical.attribute.met,
  tei.metrical.attribute.real,
  tei.metrical.attribute.rhyme,
  
  ##
  attribute type { text }?,
  
  ##
  [ a:defaultValue = "unremarkable" ] attribute status { text }?,
  
  ##
  attribute resp { xsd:IDREF }?,
  
  ##
  attribute cert { text }?,
  
  ##
  attribute hand { xsd:IDREF }?,
  [ a:defaultValue = "expunged" ] attribute TEIform { text }?
facs =
  
  ## 2004.04.28 TMB: Using 'a.seg' to include
  ##                         the attributes 'type', 'function' and 'part',
  ##                         thus the attributes in a.metrical will also be
  ##                         included, although these are probably not used
  ##                         in Menota texts. 2004.04.15 TMB: added
  ##                         comments: the element is based on the element
  ##                         'orig' in TEI, but with some changes: 'note'
  ##                         and 'm.fragmentary' are added to the content
  ##                         model, and 'function', 'part' and 'type' are
  ##                         added as attributes. The attributes 'reg' and
  ##                         'resp' are like the same attributes in the
  ##                         orig-element i TEI: 'reg' (regularization):
  ##                         gives a regularized (normalized) form of the
  ##                         text. 'resp' (responsibility): identifies the
  ##                         individual responsible for the regularization
  ##                         of the word or phrase. The attributes
  ##                         'function', 'part' and 'type' correspond to the
  ##                         same attributes in the a.seg i TEI: 'type':
  ##                         characterizes the type of segment. 'function':
  ##                         characterizes the function of the segment.
  ##                         'part': specifies whether or not the segment is
  ##                         fragmented by some other structural element,
  ##                         for example a clause which is divided between
  ##                         two or more sentences. 2003.05.14 OEH: element
  ##                         'orig' renamed to 'facs' parameter entity
  ##                         'phrase' used instead of previous content model
  ##                         to ensure conformity between the 'facs', 'dipl'
  ##                         and 'norm' elements. 2002.03.22 TMB: 'note'
  ##                         added to the content model.
  element facs { facs.content, facs.attributes }
facs.content = (text | tei.phrase | note | tei.fragmentary | tei.Incl)*
facs.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  tei.seg.attribute.type,
  tei.seg.attribute.function,
  tei.seg.attribute.part,
  tei.metrical.attribute.ass,
  tei.metrical.attribute.all,
  tei.metrical.attribute.met,
  tei.metrical.attribute.real,
  tei.metrical.attribute.rhyme,
  
  ##
  attribute resp { text }?,
  
  ##
  attribute reg { text }?,
  [ a:defaultValue = "facs" ] attribute TEIform { text }?
lemma =
  
  ## 2004.09.16 TMB: new element defined. The
  ##                         element is based on the element 'lem' in TEI
  ##                         P4.
  element lemma { lemma.content, lemma.attributes }
lemma.content =
  (text | tei.phrase | tei.Incl | tei.inter | tei.fragmentary)*
lemma.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  tei.seg.attribute.type,
  tei.seg.attribute.function,
  tei.seg.attribute.part,
  tei.metrical.attribute.ass,
  tei.metrical.attribute.all,
  tei.metrical.attribute.met,
  tei.metrical.attribute.real,
  tei.metrical.attribute.rhyme,
  [ a:defaultValue = "lemma" ] attribute TEIform { text }?
norm =
  
  ## 2004.04.29 TMB: The attribute 'orig' to
  ##                         replace 'reg', which was wrongly used here.
  ##                         2004.04.28 TMB: Using 'a.seg' to include the
  ##                         attributes 'type', 'function' and 'part', thus
  ##                         the attributes in a.metrical will also be
  ##                         included, although these are probably not used
  ##                         in Menota texts. 2004.04.15 TMB: added
  ##                         comments: the element is based on the element
  ##                         'reg' in TEI, but with some changes: 'note' and
  ##                         'm.fragmentary' are added to the content model,
  ##                         and 'function', 'part' and 'type' are added as
  ##                         attributes. The attributes 'orig' and 'resp'
  ##                         correspond to the same attributes in the
  ##                         reg-element i TEI: 'orig' (original) gives the
  ##                         unregularized form of the text as found in the
  ##                         source copy. 'resp' (responsibility) identifies
  ##                         the individual responsible for the
  ##                         regularization of the word or phrase. The
  ##                         attributes 'function', 'part' and 'type' are
  ##                         like the same attributes in the a.seg i TEI:
  ##                         'type': characterizes the type of segment.
  ##                         'function': characterizes the function of the
  ##                         segment. 'part': specifies whether or not the
  ##                         segment is fragmented by some other structural
  ##                         element, for example a clause which is divided
  ##                             between two or more sentences. 2003.05.14 OEH:
  ##                         element 'reg' renamed to 'norm', parameter
  ##                         entity 'phrase' used instead of previous
  ##                         content model to ensure conformity between the
  ##                             'facs', 'dipl' and 'norm' elements. 2002.03.22
  ##                         TMB: 'note' added to the content.
  element norm { norm.content, norm.attributes }
norm.content = (text | tei.phrase | note | tei.fragmentary | tei.Incl)*
norm.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  tei.seg.attribute.type,
  tei.seg.attribute.function,
  tei.seg.attribute.part,
  tei.metrical.attribute.ass,
  tei.metrical.attribute.all,
  tei.metrical.attribute.met,
  tei.metrical.attribute.real,
  tei.metrical.attribute.rhyme,
  
  ##
  attribute resp { text }?,
  
  ##
  attribute orig { text }?,
  [ a:defaultValue = "norm" ] attribute TEIform { text }?
pal =
  
  ## 2004.06.28 TMB: new element defined. The
  ##                         element is based on the element 'facs', but
  ##                         used to encode the paleographic level of the
  ##                         text.
  element pal { pal.content, pal.attributes }
pal.content = (text | tei.phrase | note | tei.fragmentary)*
pal.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  tei.seg.attribute.type,
  tei.seg.attribute.function,
  tei.seg.attribute.part,
  tei.metrical.attribute.ass,
  tei.metrical.attribute.all,
  tei.metrical.attribute.met,
  tei.metrical.attribute.real,
  tei.metrical.attribute.rhyme,
  
  ##
  attribute reg { text }?,
  
  ##
  attribute resp { text }?,
  [ a:defaultValue = "pal" ] attribute TEIform { text }?
punct =
  
  ## New ELEMENT punct (punctuation) Made with
  ##                         the element 'w' (word) as model, to encode
  ##                         punctuation, especially in cases when
  ##                         punctuation is added at the normalised level.
  ##                         Added by tmb, 2004.06.24
  element punct { punct.content, punct.attributes }
punct.content = macro.phraseSeq
punct.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  tei.seg.attribute.type,
  tei.seg.attribute.function,
  tei.seg.attribute.part,
  tei.metrical.attribute.ass,
  tei.metrical.attribute.all,
  tei.metrical.attribute.met,
  tei.metrical.attribute.real,
  tei.metrical.attribute.rhyme,
  
  ##
  attribute pos { text }?,
  
  ##
  attribute reg { text }?,
  [ a:defaultValue = "punct" ] attribute TEIform { text }?
textSpan =
  
  ## 2004.06.28 TMB: new element defined. The
  ##                         element is based on the element TEI 'addSpan'
  ##                         with an extra attribute 'category', and to
  ##                         encode a generic span of text that might be
  ##                         added, deleted etc. This element is a
  ##                         milestone. The element is made to avoid to make
  ##                         a series of 'delSpan', 'suppliedSpan'etc.
  element textSpan { textSpan.content, textSpan.attributes }
textSpan.content = empty
textSpan.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
  tei.linking.attribute.corresp,
  tei.linking.attribute.synch,
  tei.linking.attribute.sameAs,
  tei.linking.attribute.copyOf,
  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  
  ## 2005.06.20 TMB: the attribute value 'damage' 
  ##                                 added for the attribute 'category'
  attribute category { text }?,
  
  ##
  attribute type { text }?,
  
  ##
  attribute place { text }?,
  
  ##
  attribute resp { xsd:IDREF }?,
  
  ##
  attribute cert { text }?,
  
  ##
  attribute hand { xsd:IDREF }?,
  
  ##
  attribute to { xsd:IDREF }?,
  
  ##
  attribute source { text }?,
  
  ##
  attribute agent { text }?,
  [ a:defaultValue = "textSpan" ] attribute TEIform { text }?
start = TEI | teiCorpus
