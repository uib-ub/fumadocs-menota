  tei.linking.attribute.next,
  tei.linking.attribute.prev,
  tei.linking.attribute.exclude,
  tei.linking.attribute.select,
  tei.analysis.attribute.ana,
  
  ## indicates which edition or version the milestone applies to.
  attribute ed { text }?,
  
  ## indicates what kind of section is changing at this milestone.
  attribute unit { text },
  [ a:defaultValue = "milestone" ] attribute TEIform { text }?
pb =
  
  ## (page break) marks the boundary between one page of a text and the next
  ## in a standard reference system.
  element pb { pb.content, pb.attributes }
pb.content = empty
pb.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
