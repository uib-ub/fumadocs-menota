  tei.analysis.attribute.ana,
  [ a:defaultValue = "source" ] attribute TEIform { text }?
custodialHist =
  
  ## () contains a description of a manuscript's custodial history, either
  ## as running prose or as a series of dated custodial events. 
  element custodialHist {
    custodialHist.content, custodialHist.attributes
  }
custodialHist.content = tei.paragraph+ | custEvent+
custodialHist.attributes =
  tei.global.attribute.xmlid,
  tei.global.attribute.n,
  tei.global.attribute.xmllang,
  tei.global.attribute.rend,
  tei.global.attribute.xmlbase,
